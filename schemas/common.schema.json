{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/common.schema.json",
  "title": "Pywel common definitions",
  "definitions": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "record_id": {
      "type": "string",
      "pattern": "^(ent|clm|evd|pat|str|rcp)_[a-z0-9]{12,64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "platform": {
      "enum": ["all", "pc-steam", "pc-epic", "mac-steam", "mac-app-store", "playstation-5", "xbox-series"]
    },
    "spoiler_level": {
      "enum": ["none", "discovery", "quest_minor", "quest_major", "ending"]
    },
    "epistemic_state": {
      "enum": ["unknown", "unmeasured", "not_applicable", "conflicting", "redacted", "source_unavailable"]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_patch", "through_patch", "reviewed_through_patch", "platforms", "locales"],
      "properties": {
        "from_patch": { "type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "through_patch": { "type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "reviewed_through_patch": { "type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/platform" }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/locale" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by"],
      "properties": {
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" },
        "created_by": { "type": "string", "minLength": 2, "maxLength": 120 },
        "source_receipt_id": { "type": "string", "pattern": "^rcp_[a-z0-9]{12,64}$" }
      }
    }
  }
}
