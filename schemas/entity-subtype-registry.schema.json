{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/entity-subtype-registry.schema.json",
  "title": "Pywel entity subtype registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "subtypes"],
  "properties": {
    "schema_version": { "const": "pywel.entity_subtype_registry.v1" },
    "registry_version": { "type": "integer", "minimum": 1 },
    "subtypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subtype", "entity_types", "description", "status"],
        "properties": {
          "subtype": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "entity_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["game", "system", "item", "effect", "skill", "ability", "actor", "quest", "location", "faction", "organization", "activity", "resource", "recipe", "mechanic"]
            }
          },
          "description": { "type": "string", "minLength": 3, "maxLength": 400 },
          "status": { "enum": ["core", "provisional", "retired"] }
        }
      }
    }
  }
}
