{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/evidence-catalog.schema.json",
  "title": "Pywel evidence catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "records"],
  "properties": {
    "schema_version": { "const": "pywel.evidence_catalog.v1" },
    "catalog_id": { "type": "string", "pattern": "^cat_[a-z0-9]{12,64}$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evidence.schema.json" }
    }
  }
}
