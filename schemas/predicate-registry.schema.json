{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/predicate-registry.schema.json",
  "title": "Pywel controlled predicate registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "predicates"],
  "properties": {
    "schema_version": { "const": "pywel.predicate_registry.v1" },
    "registry_version": { "type": "integer", "minimum": 1 },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "description", "object_kinds", "status"],
        "properties": {
          "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)+$", "maxLength": 160 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "object_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["entity", "string", "number", "boolean", "range", "unknown"] }
          },
          "cardinality": {
            "enum": ["one", "many"],
            "description": "Whether multiple simultaneously valid object values are additive or contradictory. Omitted values default to one."
          },
          "units": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "status": { "enum": ["core", "provisional", "retired"] }
        }
      }
    }
  }
}
