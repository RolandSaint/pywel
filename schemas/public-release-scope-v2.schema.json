{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/public-release-scope-v2.schema.json",
  "title": "Fixed initial public reference dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "adopted_at", "baseline_commit", "historical_patch_ceiling", "milestones", "publication_boundary", "selection_rules", "record_ids", "counts", "canonical_files", "excluded_records", "record_transformations", "rights_decisions"],
  "properties": {
    "schema_version": { "const": "pywel.public_release_scope.v2" },
    "scope_id": { "const": "pywel-initial-reference-m1" },
    "adopted_at": { "type": "string", "format": "date-time" },
    "baseline_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "historical_patch_ceiling": { "const": "1.14.00" },
    "milestones": {
      "type": "object", "additionalProperties": false,
      "required": ["M0", "M1", "M2", "M3", "M4", "M5"],
      "properties": {
        "M0": { "const": "adopted" },
        "M1": { "enum": ["candidate", "verified_source_candidate"] },
        "M2": { "enum": ["pending", "verified_runtime_candidate"] }, "M3": { "enum": ["pending", "verified_contract_candidate"] },
        "M4": { "enum": ["pending", "verified_reproducible_candidate"] },
        "M5": { "enum": ["pending", "public_release_ready"] }
      }
    },
    "publication_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "original_history", "original_repository_visibility", "public_visibility_authorized"],
      "properties": {
        "mode": { "const": "clean_source_snapshot" },
        "original_history": { "const": "excluded_not_declared_clean" },
        "original_repository_visibility": { "const": "private" },
        "public_visibility_authorized": { "const": false }
      }
    },
    "selection_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "record_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["entities", "claims", "evidence", "patches", "patchChanges", "patchReviews", "strategies", "receipts"],
      "properties": {
        "entities": { "$ref": "#/definitions/ids" }, "claims": { "$ref": "#/definitions/ids" },
        "evidence": { "$ref": "#/definitions/ids" }, "patches": { "$ref": "#/definitions/ids" },
        "patchChanges": { "$ref": "#/definitions/ids" }, "patchReviews": { "$ref": "#/definitions/ids" },
        "strategies": { "$ref": "#/definitions/ids" }, "receipts": { "$ref": "#/definitions/ids" }
      }
    },
    "counts": {
      "type": "object", "minProperties": 8, "maxProperties": 8,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "canonical_files": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^data/(canonical|vocabulary)/[a-zA-Z0-9._/-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "excluded_records": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["record_id", "reason"],
        "properties": { "record_id": { "type": "string", "pattern": "^(ent|clm|evd|pat|chg|prv|str|rcp)_[a-z0-9]{12,64}$" }, "reason": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "record_transformations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rights_decisions": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_class", "disposition", "basis_url", "reviewed_at", "boundary"],
        "properties": {
          "source_class": { "type": "string" }, "disposition": { "enum": ["retained", "excluded"] },
          "basis_url": { "type": ["string", "null"], "format": "uri" },
          "reviewed_at": { "type": "string", "format": "date" }, "boundary": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(ent|clm|evd|pat|chg|prv|str|rcp)_[a-z0-9]{12,64}$" } }
  }
}
