{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/entity.schema.json",
  "title": "Pywel entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_id", "game_id", "slug", "entity_type", "canonical_name", "summary", "aliases", "tags", "provenance"],
  "properties": {
    "schema_version": { "const": "pywel.entity.v1" },
    "entity_id": { "type": "string", "pattern": "^ent_[a-z0-9]{12,64}$" },
    "game_id": { "const": "crimson_desert" },
    "slug": { "$ref": "common.schema.json#/definitions/slug" },
    "entity_type": {
      "enum": ["game", "system", "item", "effect", "skill", "ability", "actor", "quest", "location", "faction", "organization", "activity", "resource", "recipe", "mechanic"]
    },
    "subtype": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "description": "Controlled semantic subtype registered in entity-subtypes.json for this entity_type."
    },
    "redirect_entity_id": {
      "type": "string",
      "pattern": "^ent_[a-z0-9]{12,64}$",
      "description": "Canonical entity target for a preserved legacy ID or source-label variant. Redirect records remain addressable but are excluded from active-identity coverage."
    },
    "canonical_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "text"],
      "properties": {
        "locale": { "$ref": "common.schema.json#/definitions/locale" },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "text"],
        "properties": {
          "locale": { "$ref": "common.schema.json#/definitions/locale" },
          "text": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
    },
    "provenance": { "$ref": "common.schema.json#/definitions/provenance" }
  }
}
