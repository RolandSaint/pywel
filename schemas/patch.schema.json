{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/patch.schema.json",
  "title": "Pywel patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_id", "game_id", "version", "released_at", "platforms", "source_evidence_ids", "affected_entity_ids", "content_coverage", "provenance"],
  "properties": {
    "schema_version": { "const": "pywel.patch.v1" },
    "patch_id": { "type": "string", "pattern": "^pat_[a-z0-9]{12,64}$" },
    "game_id": { "const": "crimson_desert" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
    "released_at": { "$ref": "common.schema.json#/definitions/timestamp" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/definitions/platform" }
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evd_[a-z0-9]{12,64}$" }
    },
    "affected_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ent_[a-z0-9]{12,64}$" }
    },
    "content_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "normalized_claim_count", "notes"],
      "properties": {
        "level": { "enum": ["identity_only", "partial", "exhaustive"] },
        "normalized_claim_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "provenance": { "$ref": "common.schema.json#/definitions/provenance" }
  }
}
