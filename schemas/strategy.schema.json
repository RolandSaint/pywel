{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/strategy.schema.json",
  "title": "Pywel strategy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "slug", "title", "goal_entity_id", "status", "prerequisites", "entry_node_id", "nodes", "priorities", "verification", "validity", "spoiler_level", "evidence_ids", "provenance"],
  "properties": {
    "schema_version": { "const": "pywel.strategy.v1" },
    "strategy_id": { "type": "string", "pattern": "^str_[a-z0-9]{12,64}$" },
    "slug": { "$ref": "common.schema.json#/definitions/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "goal_entity_id": { "type": "string", "pattern": "^ent_[a-z0-9]{12,64}$" },
    "status": { "enum": ["source_supported", "observed", "verified", "disputed", "stale", "retracted"] },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "expected"],
        "properties": {
          "subject_entity_id": { "type": "string", "pattern": "^ent_[a-z0-9]{12,64}$" },
          "predicate": { "type": "string", "minLength": 3, "maxLength": 160 },
          "expected": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "entry_node_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "action", "instruction", "transitions"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "action": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,80}$" },
          "target_entity_id": { "type": "string", "pattern": "^ent_[a-z0-9]{12,64}$" },
          "instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "next_node_id"],
              "properties": {
                "when": { "enum": ["success", "failure", "condition_true", "condition_false"] },
                "next_node_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
              }
            }
          }
        }
      }
    },
    "priorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speed", "safety", "resource_efficiency", "accessibility"],
      "properties": {
        "speed": { "type": "number", "minimum": 0, "maximum": 1 },
        "safety": { "type": "number", "minimum": 0, "maximum": 1 },
        "resource_efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "accessibility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "successful_attempts", "independent_sources"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 0 },
        "successful_attempts": { "type": "integer", "minimum": 0 },
        "independent_sources": { "type": "integer", "minimum": 0 }
      }
    },
    "validity": { "$ref": "common.schema.json#/definitions/validity" },
    "spoiler_level": { "$ref": "common.schema.json#/definitions/spoiler_level" },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evd_[a-z0-9]{12,64}$" }
    },
    "provenance": { "$ref": "common.schema.json#/definitions/provenance" }
  }
}
