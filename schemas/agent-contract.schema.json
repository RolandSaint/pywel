{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pywelknowledge.org/schemas/agent-contract.schema.json",
  "title": "Pywel stable v1 agent responses",
  "description": "Authoritative response schemas shared by offline distribution, REST and stdio MCP. Schema URLs are identifiers and resolve to adjacent files; no network fetch is required.",
  "type": "object",
  "anyOf": [
    {
      "$ref": "#/definitions/getHealth"
    },
    {
      "$ref": "#/definitions/getServiceDescriptor"
    },
    {
      "$ref": "#/definitions/getCompactCodebook"
    },
    {
      "$ref": "#/definitions/searchKnowledge"
    },
    {
      "$ref": "#/definitions/listEntities"
    },
    {
      "$ref": "#/definitions/getEntityBundle"
    },
    {
      "$ref": "#/definitions/getEntityRelationships"
    },
    {
      "$ref": "#/definitions/listClaims"
    },
    {
      "$ref": "#/definitions/answerQuestion"
    },
    {
      "$ref": "#/definitions/listStrategies"
    },
    {
      "$ref": "#/definitions/getStrategy"
    },
    {
      "$ref": "#/definitions/listPatches"
    },
    {
      "$ref": "#/definitions/getLatestPatch"
    },
    {
      "$ref": "#/definitions/getPatchBundle"
    },
    {
      "$ref": "#/definitions/getEvidence"
    },
    {
      "$ref": "#/definitions/listEvidence"
    },
    {
      "$ref": "#/definitions/error"
    }
  ],
  "definitions": {
    "buildId": {
      "type": "string",
      "pattern": "^bld_[a-f0-9]{24}$"
    },
    "patchVersion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$",
      "maxLength": 32
    },
    "canonicalPath": {
      "type": "string",
      "pattern": "^/(?:v1(?:[/?]|$)|health$)"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch",
        "platform",
        "locale",
        "spoilerCeiling",
        "includeRetracted",
        "includeSuperseded",
        "usedLatestPatchDefault"
      ],
      "properties": {
        "patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "platform": {
          "$ref": "common.schema.json#/definitions/platform"
        },
        "locale": {
          "const": "en-US"
        },
        "spoilerCeiling": {
          "$ref": "common.schema.json#/definitions/spoiler_level"
        },
        "includeRetracted": {
          "type": "boolean"
        },
        "includeSuperseded": {
          "type": "boolean"
        },
        "usedLatestPatchDefault": {
          "type": "boolean"
        }
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch",
        "platform",
        "locale",
        "spoiler_ceiling"
      ],
      "properties": {
        "patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "platform": {
          "$ref": "common.schema.json#/definitions/platform"
        },
        "locale": {
          "const": "en-US"
        },
        "spoiler_ceiling": {
          "$ref": "common.schema.json#/definitions/spoiler_level"
        }
      }
    },
    "answerState": {
      "enum": [
        "supported",
        "partial",
        "unknown",
        "conflicting"
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "no_supported_claim",
            "requested_fact_catalog_summary_only",
            "requested_fact_not_supported",
            "patch_context_conflict",
            "patch_unknown",
            "post_patch_review_needed",
            "patch_content_not_normalized",
            "result_truncated"
          ]
        },
        "message": {
          "type": "string"
        },
        "suggested_contribution": {
          "type": "string"
        }
      }
    },
    "entityFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_known_patch",
        "context_patch_coverage",
        "review_gap_record_ids"
      ],
      "properties": {
        "latest_known_patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "context_patch_coverage": {
          "enum": [
            "identity_only",
            "partial",
            "exhaustive",
            null
          ]
        },
        "review_gap_record_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/record_id"
          }
        }
      }
    },
    "answerFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_known_patch",
        "generated_from_corpus_at"
      ],
      "properties": {
        "latest_known_patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "generated_from_corpus_at": {
          "$ref": "common.schema.json#/definitions/timestamp"
        }
      }
    },
    "relationshipEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "subject_entity_id",
        "predicate",
        "object_entity_id",
        "status",
        "confidence",
        "evidence_ids",
        "validity"
      ],
      "properties": {
        "claim_id": {
          "$ref": "claim.schema.json#/properties/claim_id"
        },
        "subject_entity_id": {
          "$ref": "claim.schema.json#/properties/subject_entity_id"
        },
        "predicate": {
          "$ref": "claim.schema.json#/properties/predicate"
        },
        "object_entity_id": {
          "$ref": "entity.schema.json#/properties/entity_id"
        },
        "status": {
          "$ref": "claim.schema.json#/properties/status"
        },
        "confidence": {
          "$ref": "claim.schema.json#/properties/confidence"
        },
        "evidence_ids": {
          "$ref": "claim.schema.json#/properties/evidence_ids"
        },
        "validity": {
          "$ref": "common.schema.json#/definitions/validity"
        }
      }
    },
    "relationshipGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "root_entity_id",
        "depth",
        "nodes",
        "edges",
        "truncated"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.relationship_graph.v1"
        },
        "root_entity_id": {
          "$ref": "entity.schema.json#/properties/entity_id"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "entity.schema.json"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relationshipEdge"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "searchHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "score",
        "title",
        "snippet",
        "entity_id",
        "canonical_path",
        "patch",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "claim",
            "strategy"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/definitions/record_id"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "$ref": "entity.schema.json#/properties/entity_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_path": {
          "$ref": "#/definitions/canonicalPath"
        },
        "patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "status": {
          "enum": [
            "canonical",
            "official",
            "observed",
            "corroborated",
            "inferred",
            "disputed",
            "stale",
            "retracted",
            "source_supported",
            "verified"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.error.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "request_too_large",
                "invalid_query",
                "invalid_pagination",
                "invalid_context",
                "invalid_status",
                "invalid_format",
                "entity_not_found",
                "strategy_not_found",
                "strategy_outside_context",
                "patch_unknown",
                "patch_not_found",
                "evidence_not_found",
                "not_found",
                "internal_error"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "getHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "status",
        "service",
        "latest_known_patch",
        "latest_patch_content_coverage",
        "corpus",
        "writes_enabled"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.health.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "status": {
          "const": "ok"
        },
        "service": {
          "const": "pywel-knowledge-standard"
        },
        "latest_known_patch": {
          "$ref": "#/definitions/patchVersion"
        },
        "latest_patch_content_coverage": {
          "anyOf": [
            {
              "$ref": "patch.schema.json#/properties/content_coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities",
            "claims",
            "evidence",
            "strategies",
            "patch_content_coverage"
          ],
          "properties": {
            "entities": {
              "type": "integer",
              "minimum": 0
            },
            "claims": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "integer",
              "minimum": 0
            },
            "strategies": {
              "type": "integer",
              "minimum": 0
            },
            "patch_content_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity_only",
                "partial",
                "exhaustive"
              ],
              "properties": {
                "identity_only": {
                  "type": "integer",
                  "minimum": 0
                },
                "partial": {
                  "type": "integer",
                  "minimum": 0
                },
                "exhaustive": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "writes_enabled": {
          "const": false
        }
      }
    },
    "getServiceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "name",
        "game",
        "unofficial",
        "default_context",
        "transports",
        "writes_enabled",
        "endpoints",
        "behavior_contract",
        "schema_bundle_path"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.service.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "name": {
          "const": "Pywel Knowledge Standard"
        },
        "game": {
          "const": "Crimson Desert"
        },
        "unofficial": {
          "const": true
        },
        "default_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patch",
            "platform",
            "locale",
            "spoiler"
          ],
          "properties": {
            "patch": {
              "$ref": "#/definitions/patchVersion"
            },
            "platform": {
              "const": "all"
            },
            "locale": {
              "const": "en-US"
            },
            "spoiler": {
              "const": "none"
            }
          }
        },
        "transports": {
          "const": [
            "local_http_get",
            "stdio_mcp"
          ]
        },
        "writes_enabled": {
          "const": false
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "search",
            "answer",
            "entities",
            "claims",
            "strategies",
            "patches",
            "evidence",
            "evidence_record",
            "codebook"
          ],
          "properties": {
            "search": {
              "$ref": "#/definitions/canonicalPath"
            },
            "answer": {
              "$ref": "#/definitions/canonicalPath"
            },
            "entities": {
              "$ref": "#/definitions/canonicalPath"
            },
            "claims": {
              "$ref": "#/definitions/canonicalPath"
            },
            "strategies": {
              "$ref": "#/definitions/canonicalPath"
            },
            "patches": {
              "$ref": "#/definitions/canonicalPath"
            },
            "evidence": {
              "$ref": "#/definitions/canonicalPath"
            },
            "evidence_record": {
              "$ref": "#/definitions/canonicalPath"
            },
            "codebook": {
              "$ref": "#/definitions/canonicalPath"
            }
          }
        },
        "behavior_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unsupported",
            "disputes",
            "stale",
            "default_patch",
            "patch_coverage",
            "citations",
            "official_intent_is_observation"
          ],
          "properties": {
            "unsupported": {
              "const": "structured_unknown_with_gap"
            },
            "disputes": {
              "const": "returned_without_forced_resolution"
            },
            "stale": {
              "const": "included_with_warning"
            },
            "default_patch": {
              "const": "latest_indexed_historical_patch_and_reported"
            },
            "patch_coverage": {
              "const": "identity_separate_from_normalized_content"
            },
            "citations": {
              "const": "claim_level_evidence_ids"
            },
            "official_intent_is_observation": {
              "const": false
            }
          }
        },
        "schema_bundle_path": {
          "const": "schemas/agent-contract.schema.json"
        }
      }
    },
    "searchKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "query",
        "context",
        "count",
        "total",
        "offset",
        "next_offset",
        "hits"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.search.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "query": {
          "type": "string"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/searchHit"
          }
        }
      }
    },
    "listEntities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "count",
        "total",
        "offset",
        "next_offset",
        "entities"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.entity_list.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "entity.schema.json"
          }
        }
      }
    },
    "getEntityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "canonical_path",
        "entity",
        "redirected_from",
        "claims",
        "strategies",
        "evidence",
        "context",
        "freshness",
        "warnings",
        "relationships"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.entity_bundle.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "canonical_path": {
          "$ref": "#/definitions/canonicalPath"
        },
        "entity": {
          "$ref": "entity.schema.json"
        },
        "redirected_from": {
          "anyOf": [
            {
              "$ref": "entity.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "claim.schema.json"
          }
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "strategy.schema.json"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "evidence.schema.json"
          }
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "freshness": {
          "$ref": "#/definitions/entityFreshness"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "$ref": "#/definitions/relationshipGraph"
        }
      }
    },
    "getEntityRelationships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "context",
        "root_entity_id",
        "depth",
        "nodes",
        "edges",
        "truncated"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.relationship_graph.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "root_entity_id": {
          "$ref": "entity.schema.json#/properties/entity_id"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "entity.schema.json"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relationshipEdge"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "listClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "context",
        "count",
        "total",
        "offset",
        "next_offset",
        "claims"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.claim_list.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "claim.schema.json"
          }
        }
      }
    },
    "answerFull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "canonical_path",
        "answer_state",
        "query",
        "assumptions",
        "concise_answer",
        "entities",
        "claims",
        "evidence",
        "strategies",
        "warnings",
        "gaps",
        "freshness",
        "selection"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.answer.v1"
        },
        "build_id": {
          "$ref": "#/definitions/buildId"
        },
        "canonical_path": {
          "$ref": "#/definitions/canonicalPath"
        },
        "answer_state": {
          "$ref": "#/definitions/answerState"
        },
        "query": {
          "type": "string"
        },
        "assumptions": {
          "$ref": "#/definitions/assumptions"
        },
        "concise_answer": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "entity.schema.json"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "claim.schema.json"
          },
          "maxItems": 20
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "evidence.schema.json"
          }
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "strategy.schema.json"
          },
          "maxItems": 8
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gap"
          }
        },
        "freshness": {
          "$ref": "#/definitions/answerFreshness"
        },
        "selection": {
          "$ref": "#/definitions/selection"
        }
      }
    },
    "answerQuestion": {
      "anyOf": [
        {
          "$ref": "#/definitions/answerFull"
        },
        {
          "$ref": "#/definitions/answerCompact"
        }
      ]
    },
    "listStrategies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "build_id",
        "context",
        "count",
        "total",
        "offset",
        "next_offset",
        "strategies"
      ],
      "properties": {
        "schema_version": {
          "const": "pywel.strategy_list.v1"
        },
        "build_id": {
