{
  "openapi": "3.1.0",
  "info": {
    "title": "Pywel Knowledge Standard API",
    "version": "1.0.0",
    "description": "Unofficial read-only local Crimson Desert reference interface. Frozen v1 agent contract. Historical coverage is finite; the latest indexed patch is not the current game patch. No hosted endpoint is promised. All inputs are closed: unknown or duplicate parameters, unsupported enum values, and out-of-range numbers are rejected.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local loopback reference server; PORT can select another local port."
    }
  ],
  "tags": [
    {
      "name": "discovery"
    },
    {
      "name": "knowledge"
    },
    {
      "name": "sources"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "discovery"
        ],
        "summary": "Read service and corpus health",
        "responses": {
          "200": {
            "description": "Versioned getHealth response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/getHealth"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "414": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "parameters": []
      }
    },
    "/v1": {
      "get": {
        "operationId": "getServiceDescriptor",
        "tags": [
          "discovery"
