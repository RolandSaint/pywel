            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/strategies/{id}": {
      "get": {
        "operationId": "getStrategy",
        "tags": [
          "knowledge"
        ],
        "summary": "Fetch one complete ordered strategy graph after discovering its compact pointer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "required": true,
            "description": "Stable strategy ID or slug."
          },
          {
            "$ref": "#/components/parameters/Patch"
          },
          {
            "$ref": "#/components/parameters/Platform"
          },
          {
            "$ref": "#/components/parameters/Locale"
          },
          {
            "$ref": "#/components/parameters/Spoiler"
          },
          {
            "$ref": "#/components/parameters/IncludeRetracted"
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned getStrategy response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/getStrategy"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "414": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/patches": {
      "get": {
        "operationId": "listPatches",
        "tags": [
          "sources"
        ],
        "summary": "List known patches and their official evidence",
        "responses": {
          "200": {
            "description": "Versioned listPatches response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/listPatches"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
