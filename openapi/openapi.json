    "/v1/patches/latest": {
      "get": {
        "operationId": "getLatestPatch",
        "tags": [
          "sources"
        ],
        "summary": "Get the latest indexed historical patch bundle",
        "responses": {
          "200": {
            "description": "Versioned getLatestPatch response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/getLatestPatch"
                }
