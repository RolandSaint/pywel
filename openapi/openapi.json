          "secondary",
          "unverified"
        ]
      }
    }
  },
  "x-pywel-contract": {
    "status": "frozen_v1",
    "default_patch": "latest_indexed_historical_patch_and_reported",
    "review_boundary": "specific_claim_not_patch_ingestion",
    "unknown_behavior": "explicit_gap_without_unqualified_support",
    "conflicts": "preserved",
    "citations": "claim_level_evidence_ids",
    "source_is_instruction": false,
    "writes_enabled": false,
    "runtime_storage": "validated_public_projection_of_canonical_JSON",
    "cache_policy": "no-store",
    "build_header": "X-Pywel-Build; identifies declared source inputs and the pinned runtime",
    "pagination": "offset and next_offset; one build and unchanged filters",
    "default_spoiler": "none",
    "supported_locales": [
      "en-US"
    ],
    "schema_bundle_path": "schemas/agent-contract.schema.json",
    "schema_resolution": "Schema URLs are identifiers. Resolve them to the shipped adjacent schemas directory without network access.",
    "compatibility": "Objects are closed. New fields, enum values, tuple shapes, changed defaults or meanings require a new schema version; breaking route or input changes require a new API major version."
  },
  "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#"
}
