            "$ref": "#/components/responses/InternalError"
          }
        },
        "parameters": []
      }
    },
    "/v1/patches/{version}": {
      "get": {
        "operationId": "getPatchBundle",
        "tags": [
          "sources"
        ],
        "summary": "Get a patch identity with its linked claims and evidence",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$",
              "maxLength": 32
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned getPatchBundle response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/getPatchBundle"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "414": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "description": "Returns patch identity and directly linked canonical claims and evidence. Patch bundles are historical source records and do not imply that their assertions remain current."
      }
    },
    "/v1/evidence/{id}": {
      "get": {
        "operationId": "getEvidence",
        "tags": [
