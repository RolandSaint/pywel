            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/evidence": {
      "get": {
        "operationId": "listEvidence",
        "tags": [
          "sources"
        ],
        "summary": "List evidence locators with rights and reliability labels",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/EvidenceType"
            }
          },
          {
            "name": "tier",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ReliabilityTier"
            }
          },
          {
            "name": "rights_mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "locator_only",
                "normalized_facts",
                "authorized_excerpt"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/Limit200"
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned listEvidence response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/agent-contract.schema.json#/definitions/listEvidence"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "414": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Patch": {
        "name": "patch",
        "in": "query",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$",
          "maxLength": 32
        },
        "description": "Omit to use and report the latest indexed historical patch. Syntactically valid unindexed versions remain explicit unknown applicability."
      },
      "Platform": {
        "name": "platform",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/Platform",
          "default": "all"
        }
      },
      "Locale": {
        "name": "locale",
        "in": "query",
        "schema": {
          "type": "string",
          "const": "en-US",
          "default": "en-US"
        },
        "description": "Only en-US is supported. Other locales are rejected."
      },
      "Spoiler": {
        "name": "spoiler",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/Spoiler",
          "default": "none"
        },
        "description": "Maximum spoiler level allowed. Omission always means none, including acquisition and quest questions."
      },
      "IncludeRetracted": {
        "name": "include_retracted",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "IncludeSuperseded": {
        "name": "include_superseded",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0
        },
        "description": "Zero-based offset within a fixed build. Keep build_id, filters and context unchanged between pages; restart pagination when the build changes."
      },
      "Limit100": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Limit200": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "Limit500": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid, duplicate, unknown, unsupported, or out-of-range input.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/agent-contract.schema.json#/definitions/error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Route or record not found, or strategy outside the requested context.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/agent-contract.schema.json#/definitions/error"
            }
          }
        }
      },
      "RequestTooLarge": {
        "description": "Request URL exceeds 8192 characters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/agent-contract.schema.json#/definitions/error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Request could not be completed; internal details are withheld.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/agent-contract.schema.json#/definitions/error"
            }
          }
        }
      }
    },
    "schemas": {
      "Platform": {
        "type": "string",
        "enum": [
          "all",
          "pc-steam",
          "pc-epic",
          "mac-steam",
          "mac-app-store",
          "playstation-5",
          "xbox-series"
        ]
      },
      "Spoiler": {
        "type": "string",
        "enum": [
          "none",
          "discovery",
          "quest_minor",
          "quest_major",
          "ending"
        ]
      },
      "ClaimStatus": {
        "type": "string",
        "enum": [
          "official",
          "observed",
          "corroborated",
          "inferred",
          "disputed",
          "stale",
          "retracted"
        ]
      },
      "EntityType": {
        "type": "string",
        "enum": [
          "game",
          "system",
          "item",
          "effect",
          "skill",
          "ability",
          "actor",
          "quest",
          "location",
          "faction",
          "organization",
          "activity",
          "resource",
          "recipe",
          "mechanic"
        ]
      },
      "EvidenceType": {
        "type": "string",
        "enum": [
